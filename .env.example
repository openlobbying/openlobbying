# Shared application databases.
MUCKRAKE_DATABASE_URL=postgresql://myproject:secret@localhost:5432/myproject
MUCKRAKE_PUBLISHED_DATABASE_URL=postgresql://myproject:secret@localhost:5432/myproject_published

# OpenLobbying API and frontend runtime.
OPENLOBBYING_API_URL=http://127.0.0.1:8000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:5173

# Optional: separate the admin API secret from Better Auth.
# OPENLOBBYING_ADMIN_API_SECRET=

# Optional muckrake overrides.
# MUCKRAKE_DATA_PATH=data
# MUCKRAKE_ARTIFACT_PATH=data/artifacts
# MUCKRAKE_DATASET_PATHS=datasets
# MUCKRAKE_ENV_FILE=.env

# Optional enrichment settings.
# OPENROUTER_API_KEY=
# LLM_MODEL=
# NER_LLM_PROMPT_FILE=
# LOGFIRE_TOKEN=
