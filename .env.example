# Copy to .env. muckrake (and so the API) reads it when run from this repo, and the
# Vite dev server reads it too. Variables already set in your shell win. muckrake
# skips the file when ENVIRONMENT=production; the Vite dev server does not.

# Databases. Two setups:
#
# 1. SQLite (default, no setup): leave MUCKRAKE_DATABASE_URL unset and the working
#    DB is data/muckrake.db. Enough for crawling, loading, releases and the API,
#    but not for the frontend (Better Auth needs Postgres).
#
# 2. Postgres: needed for the frontend, and what the full-scale ingest uses.
#    `docker compose up -d db` in ../muckrake starts one on port 5433 with both
#    databases below (the undertheinfluence umbrella stack uses port 5432).
#
# The published (serving) DB must be a different database from the working DB:
# release-publish refuses otherwise. The API reads the published DB.
#
# SQLite:
# MUCKRAKE_PUBLISHED_DATABASE_URL=sqlite:///data/published.db
#
# Postgres:
# MUCKRAKE_DATABASE_URL=postgresql://muckrake:muckrake@localhost:5433/muckrake
# MUCKRAKE_PUBLISHED_DATABASE_URL=postgresql://muckrake:muckrake@localhost:5433/muckrake_published

# OpenLobbying API and frontend runtime. The Vite dev server proxies /api to
# OPENLOBBYING_API_URL.
OPENLOBBYING_API_URL=http://127.0.0.1:8000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:5173

# Optional: separate the admin API secret from Better Auth.
# OPENLOBBYING_ADMIN_API_SECRET=

# Optional muckrake overrides.
# MUCKRAKE_DATA_PATH=data
# MUCKRAKE_ARTIFACT_PATH=data/artifacts
# MUCKRAKE_DATASET_PATHS=      # extra dataset roots (os.pathsep-separated); ./datasets is always searched
# MUCKRAKE_ENV_FILE=.env
# MUCKRAKE_HTTP_MIN_INTERVAL=0

# Optional: link each entity in the `muckrake dedupe` TUI to its profile page
# (%s is replaced by the entity ID).
# MUCKRAKE_PROFILE_URL=https://openlobbying.org/profile/%s/

# Optional LLM NER (ner-extract --extractor llm). The provider prefix is required.
# LLM_MODEL=openrouter:<model> or anthropic:<model>
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# NER_LLM_PROMPT_FILE=
# LOGFIRE_TOKEN=
